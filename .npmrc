# 国内源：npmmirror（阿里云镜像）
registry=https://registry.npmmirror.com

# 本机 npm 默认缓存目录 C:\App\Node\nodejs24\node_cache 写入被系统拒绝（EPERM），
# 所以把 npm 缓存放到工程内，跑命令时保持在工程根目录即可（pnpm 用自身的 store，不受该项影响）。
cache=./.npm-cache

# 需要下载二进制（esbuild / electron / node 等）时再按需打开：
# electron_mirror=https://npmmirror.com/mirrors/electron/
# node_mirror=https://npmmirror.com/mirrors/node/
